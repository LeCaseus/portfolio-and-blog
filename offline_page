  <script>
    // Self-contained, no /shared.js or /styles.css imports. If this page is being
    // served, the origin those live on is probably unreachable.
    const theme_checkbox = document.querySelector('[data-theme-toggle]');
    theme_checkbox.checked = document.documentElement.getAttribute('data-theme') === 'dark';
    theme_checkbox.addEventListener('change', () => {
      const next_theme = theme_checkbox.checked ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next_theme);
      localStorage.setItem('cv.theme', next_theme);
    });

    const pad = number => String(number).padStart(2, '0');
    const tick_clock = () => {
      const now = new Date();
      const formatted = pad(now.getUTCHours()) + ':' + pad(now.getUTCMinutes()) + ':' + pad(now.getUTCSeconds());
      document.querySelectorAll('[data-clock]').forEach(el => el.textContent = formatted);
    };
    tick_clock();
    setInterval(tick_clock, 1000);

    // The worker answers non-html requests with a 503 while the origin is down,
    // so a 2xx here means the real site is back.
    const last_check_el = document.querySelector('[data-last-check]');
    const probe_origin = async () => {
      try {
        const response = await fetch('/api/messages', { cache: 'no-store' });
        if (response.ok) location.reload();
      } catch {}
      const now = new Date();
      last_check_el.textContent = pad(now.getUTCHours()) + ':' + pad(now.getUTCMinutes()) + ' UTC';
    };
    if (location.pathname !== '/__offline') setInterval(probe_origin, 30000);
    document.querySelector('[data-retry]').addEventListener('click', () => location.reload());
  </script>

