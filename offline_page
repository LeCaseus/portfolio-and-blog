const wants_html = request => (request.headers.get('Accept') || '').includes('text/html');

const offline_response = request => {
  const html = wants_html(request);
  const headers = {
    'Content-Type': html ? 'text/html;charset=UTF-8' : 'text/plain;charset=UTF-8',
    'Retry-After': '300',
    'Cache-Control': 'no-store'
  };
  if (html) headers['X-Robots-Tag'] = 'noindex';

  return new Response(html ? OFFLINE_HTML : 'origin offline', { status: 503, headers });
};

export default {
  async fetch(request) {
    if (new URL(request.url).pathname === '/__offline') return offline_response(request);

    try {
      const response = await fetch(request);
      if (response.status < 500) return response;
      return offline_response(request);
    } catch {
      return offline_response(request);
    }
  }
};

