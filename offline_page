  <script>
    // Self-contained -- no /shared.js, /main.js, or /styles.css imports.
    // If this page is being served, the origin those live on may be unreachable.
    const root = document.documentElement;
    const stored_theme = localStorage.getItem('cv.theme');
    const prefers_dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const initial_theme = stored_theme || (prefers_dark ? 'dark' : 'light');
    root.setAttribute('data-theme', initial_theme);

    const theme_checkbox = document.querySelector('[data-theme-toggle]');
    theme_checkbox.checked = initial_theme === 'dark';
    theme_checkbox.addEventListener('change', () => {
      const next_theme = theme_checkbox.checked ? 'dark' : 'light';
      root.setAttribute('data-theme', next_theme);
      localStorage.setItem('cv.theme', next_theme);
    });

    const pad = number => String(number).padStart(2, '0');
    const tick_clock = () => {
      const now = new Date();
      const formatted = \`\${pad(now.getUTCHours())}:\${pad(now.getUTCMinutes())}:\${pad(now.getUTCSeconds())}\`;
      document.querySelectorAll('[data-clock]').forEach(el => el.textContent = formatted);
    };
    tick_clock();
    setInterval(tick_clock, 1000);

    const mobile_toggle = document.getElementById('mobile-nav-check');
    if (mobile_toggle) {
      document.querySelectorAll('.nav-col .nav-chip').forEach(link => {
        link.addEventListener('click', () => { mobile_toggle.checked = false; });
      });
    }
  </script>

