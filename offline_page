export default {
  async fetch(request, env) {
    try {
      const response = await fetch(request);
      if (response.status >= 500) {
        return new Response(OFFLINE_HTML, {
          status: 200,
          headers: { 'Content-Type': 'text/html;charset=UTF-8' }
        });
      }
      return response;
    } catch {
      return new Response(OFFLINE_HTML, {
        status: 200,
        headers: { 'Content-Type': 'text/html;charset=UTF-8' }
      });
    }
  }
};

